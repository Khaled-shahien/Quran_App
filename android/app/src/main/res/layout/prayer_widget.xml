<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: the day's prayers, next one highlighted. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/prayer_widget_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/prayer_place"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFF4E6C8"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/prayer_hijri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#CCF4E6C8"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/prayer_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/prayer_widget_empty"
        android:textColor="#FFF4E6C8"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/prayer_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout android:id="@+id/prayer_row_0" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_0" style="@style/PrayerWidgetName" />
            <TextView android:id="@+id/prayer_time_0" style="@style/PrayerWidgetTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_row_1" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_1" style="@style/PrayerWidgetName" />
            <TextView android:id="@+id/prayer_time_1" style="@style/PrayerWidgetTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_row_2" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_2" style="@style/PrayerWidgetName" />
            <TextView android:id="@+id/prayer_time_2" style="@style/PrayerWidgetTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_row_3" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_3" style="@style/PrayerWidgetName" />
            <TextView android:id="@+id/prayer_time_3" style="@style/PrayerWidgetTime" />
        </LinearLayout>
        <LinearLayout android:id="@+id/prayer_row_4" style="@style/PrayerWidgetCell">
            <TextView android:id="@+id/prayer_name_4" style="@style/PrayerWidgetName" />
            <TextView android:id="@+id/prayer_time_4" style="@style/PrayerWidgetTime" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
