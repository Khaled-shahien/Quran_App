<?xml version="1.0" encoding="utf-8"?>
<!-- Redrawn every 30 minutes (the platform minimum) and by the app after
     each change; the widget picks the next prayer from the clock itself. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/prayer_widget_description"
    android:initialLayout="@layout/prayer_widget"
    android:minWidth="250dp"
    android:minHeight="70dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
